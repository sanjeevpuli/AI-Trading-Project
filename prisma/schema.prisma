generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id             String             @id @default(uuid())
  email          String             @unique
  password       String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  executionLogs  ExecutionLog[]
  portfolios     Portfolio?
  metricsHistory PortfolioMetrics[]
  positions           Position[]
  trades              Trade[]
  watchlist           Watchlist?
  passwordResetTokens PasswordResetToken[]
}

model Portfolio {
  id            String   @id @default(uuid())
  userId        String   @unique
  totalValue    Float    @default(100000.0)
  cash          Float    @default(100000.0)
  unrealizedPnL Float    @default(0.0)
  realizedPnL   Float    @default(0.0)
  winRate       Float    @default(0.0)
  sharpeRatio   Float    @default(0.0)
  maxDrawdown   Float    @default(0.0)
  leverage      Float    @default(1.0)
  exposure      Float    @default(0.0)
  netBeta       Float    @default(0.0)
  valueAtRisk   Float    @default(0.0)
  equityCurve   Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Trade {
  id            String   @id @default(uuid())
  userId        String
  symbol        String
  type          String
  entryPrice    Float
  exitPrice     Float
  amount        Float
  pnl           Float
  pnlPercentage Float
  entryTime     DateTime
  exitTime      DateTime
  exitReason    String
  fee           Float    @default(0.0)
  slippage      Float    @default(0.0)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Position {
  id            String   @id @default(uuid())
  userId        String
  symbol        String
  type          String
  entryPrice    Float
  currentPrice  Float
  amount        Float
  stopLoss      Float?
  takeProfit    Float?
  timestamp     DateTime @default(now())
  pnl           Float    @default(0.0)
  pnlPercentage Float    @default(0.0)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgentSignal {
  id         String   @id @default(uuid())
  symbol     String
  agentId    String
  type       String
  confidence Float
  reason     String
  riskScore  Float
  timestamp  DateTime @default(now())
}

model PortfolioMetrics {
  id            String   @id @default(uuid())
  userId        String
  timestamp     DateTime @default(now())
  totalValue    Float
  cash          Float
  realizedPnL   Float
  unrealizedPnL Float
  drawDown      Float
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Watchlist {
  id        String   @id @default(uuid())
  userId    String   @unique
  symbols   String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExecutionLog {
  id        String   @id @default(uuid())
  userId    String
  level     String
  message   String
  details   String?
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
