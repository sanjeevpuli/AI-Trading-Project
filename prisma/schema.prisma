generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum OrderType {
  MARKET
  LIMIT
}

enum PositionType {
  LONG
  SHORT
}

enum OrderStatus {
  PENDING
  FILLED
  CANCELED
}

enum ExitReason {
  MANUAL
  STOP_LOSS
  TAKE_PROFIT
  LIQUIDATION
}

model User {
  id             String             @id @default(uuid())
  email          String             @unique
  password       String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  executionLogs  ExecutionLog[]
  portfolios     Portfolio?
  metricsHistory PortfolioMetrics[]
  positions           Position[]
  trades              Trade[]
  orders              Order[]
  watchlist           Watchlist?
  passwordResetTokens PasswordResetToken[]
  settings            UserSettings?
  notifications       Notification[]
}

model Portfolio {
  id            String   @id @default(uuid())
  userId        String   @unique
  totalValue    Float    @default(100000.0)
  cash          Float    @default(100000.0)
  unrealizedPnL Float    @default(0.0)
  realizedPnL   Float    @default(0.0)
  winRate       Float    @default(0.0)
  sharpeRatio   Float    @default(0.0)
  maxDrawdown   Float    @default(0.0)
  leverage      Float    @default(1.0)
  exposure      Float    @default(0.0)
  netBeta       Float    @default(0.0)
  valueAtRisk   Float    @default(0.0)
  equityCurve   Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Trade {
  id            String       @id @default(uuid())
  userId        String
  symbol        String
  type          PositionType
  entryPrice    Float
  exitPrice     Float
  amount        Float
  pnl           Float
  pnlPercentage Float
  entryTime     DateTime
  exitTime      DateTime
  exitReason    ExitReason
  fee           Float        @default(0.0)
  slippage      Float        @default(0.0)
  createdAt     DateTime     @default(now())
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, exitTime(sort: Desc)])
}

model Position {
  id            String       @id @default(uuid())
  userId        String
  symbol        String
  type          PositionType
  entryPrice    Float
  currentPrice  Float
  amount        Float
  stopLoss      Float?
  takeProfit    Float?
  timestamp     DateTime     @default(now())
  pnl           Float        @default(0.0)
  pnlPercentage Float        @default(0.0)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id          String       @id @default(uuid())
  userId      String
  symbol      String
  type        PositionType
  orderType   OrderType
  status      OrderStatus  @default(PENDING)
  amount      Float
  price       Float
  stopLoss    Float?
  takeProfit  Float?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgentSignal {
  id         String   @id @default(uuid())
  symbol     String
  agentId    String
  type       String
  confidence Float
  reason     String
  riskScore  Float
  timestamp  DateTime @default(now())

  @@index([timestamp(sort: Desc)])
}

model PortfolioMetrics {
  id            String   @id @default(uuid())
  userId        String
  timestamp     DateTime @default(now())
  totalValue    Float
  cash          Float
  realizedPnL   Float
  unrealizedPnL Float
  drawDown      Float
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp(sort: Asc)])
}

model Watchlist {
  id        String   @id @default(uuid())
  userId    String   @unique
  symbols   String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExecutionLog {
  id        String   @id @default(uuid())
  userId    String
  level     String
  message   String
  details   String?
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp(sort: Desc)])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id                    String   @id @default(uuid())
  userId                String   @unique
  theme                 String   @default("dark")
  defaultSymbol         String   @default("BTCUSDT")
  defaultTimeframe      String   @default("60")
  riskPreferences       String   @default("moderate") // conservative, moderate, aggressive
  tradingPreferences    String   @default("manual") // manual, automated, semi-automated
  language              String   @default("en")
  timezone              String   @default("UTC")
  notificationPreferences Json     @default("{\"tradeExecuted\":true,\"positionClosed\":true,\"stopLossHit\":true,\"takeProfitHit\":true,\"aiConsensus\":false,\"riskAlerts\":true,\"portfolioAlerts\":true,\"systemNotifications\":true}")
  aiPreferences         Json     @default("{\"agentAutonomy\":\"low\",\"riskTolerance\":\"medium\"}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   // e.g., TRADE_EXECUTED, POSITION_CLOSED, STOP_LOSS, TAKE_PROFIT, AI_CONSENSUS, RISK_ALERT, SYSTEM
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
